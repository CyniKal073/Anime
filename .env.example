# nekoBT：公开检索不需要 Key；仅非公开种子（private_magnet）才需要
NEKOBT_API_KEY=

# qBittorrent WebUI（需先在客户端里启用 WebUI 并设置账号密码）
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=
QBIT_SAVEPATH=D:\Anime\library
QBIT_CATEGORY=anime
QBIT_TAGS=nekobt
# 下载时若 qBittorrent 未运行，尝试启动这个可执行文件（留空则只报错不启动）
QBIT_EXECUTABLE=F:\qBittorrentEE\qbittorrent_x64.exe

# MKVToolNix 目录（用于提取/合并内封字幕）
MKV_TOOLS_DIR=F:\MKVToolNix

# 射手网（assrt.net）字幕库 API token：登录后在个人页面获取
ASSRT_TOKEN=

HTTP_TIMEOUT=20
HTTP_RETRIES=3

# 代理。留空 = 自动读取 Windows 系统代理（多数代理客户端是这种模式：
# 浏览器会自动走，但 requests/curl 不读注册表，所以工具得自己读）。
# 想强制直连就把系统代理关掉；想指定别的代理就填在这里。
ANIME_PROXY=
